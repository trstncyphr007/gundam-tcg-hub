# Every environment variable the stack uses (plan Appendix A).
# Don't copy this by hand: run `pnpm env:init` to generate .env with real random secrets.
NODE_ENV=development
LOG_LEVEL=debug

API_HOST=127.0.0.1
API_PORT=4000
API_TRUST_PROXY=false
API_RATE_LIMIT_MAX=120

PG_SUPERUSER=gth_admin
PG_SUPERPASSWORD=generated-by-env-init
PG_DATABASE=gth
PG_MIGRATOR_PASSWORD=generated-by-env-init
PG_WEB_PASSWORD=generated-by-env-init
PG_WORKER_PASSWORD=generated-by-env-init
PG_READONLY_PASSWORD=generated-by-env-init
DATABASE_URL_MIGRATOR=postgres://app_migrator:generated-by-env-init@127.0.0.1:5432/gth
DATABASE_URL_WEB=postgres://app_web:generated-by-env-init@127.0.0.1:5432/gth
DATABASE_URL_WORKER=postgres://app_worker:generated-by-env-init@127.0.0.1:5432/gth
DATABASE_URL_READONLY=postgres://app_readonly:generated-by-env-init@127.0.0.1:5432/gth

VALKEY_PASSWORD=generated-by-env-init
VALKEY_URL=redis://:generated-by-env-init@127.0.0.1:6379/0

TOKEN_PEPPER=generated-by-env-init

OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
