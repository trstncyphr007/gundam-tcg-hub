# Every environment variable the stack uses (plan Appendix A).
# Don't copy this by hand: run `pnpm env:init` to generate .env with real random secrets.
NODE_ENV=development
LOG_LEVEL=debug

API_HOST=127.0.0.1
API_PORT=4000
# true when the API runs behind our proxy (web app / Caddy), which overwrites X-Forwarded-For
API_TRUST_PROXY=true
API_RATE_LIMIT_MAX=120

PG_SUPERUSER=gth_admin
PG_SUPERPASSWORD=generated-by-env-init
PG_DATABASE=gth
PG_MIGRATOR_PASSWORD=generated-by-env-init
PG_WEB_PASSWORD=generated-by-env-init
PG_WORKER_PASSWORD=generated-by-env-init
PG_READONLY_PASSWORD=generated-by-env-init
DATABASE_URL_MIGRATOR=postgres://app_migrator:generated-by-env-init@127.0.0.1:5432/gth
DATABASE_URL_WEB=postgres://app_web:generated-by-env-init@127.0.0.1:5432/gth
DATABASE_URL_WORKER=postgres://app_worker:generated-by-env-init@127.0.0.1:5432/gth
DATABASE_URL_READONLY=postgres://app_readonly:generated-by-env-init@127.0.0.1:5432/gth

TOKEN_PEPPER=generated-by-env-init

# Encrypts database fields that must stay secret even in a backup — today a break's server
# seed (SR-4.2). Keyed by id so keys can rotate: keep old keys here so old rows still open,
# and point ACTIVE_KID at the one new writes should use. The API refuses to start in
# production while this is still the development default.
# Quoted because it is JSON and some readers of this file are shells: unquoted, sourcing it
# strips the inner quotes and the application gets something that is not JSON.
DATA_ENCRYPTION_KEYS='{"k1":"generated-by-env-init"}'
DATA_ENCRYPTION_ACTIVE_KID=k1

# Auth (plan §10). BETTER_AUTH_SECRET must be >=32 chars of CSPRNG output.
API_BASE_URL=http://127.0.0.1:4000
APP_BASE_URL=http://127.0.0.1:3000
BETTER_AUTH_SECRET=generated-by-env-init
SMTP_URL=smtp://127.0.0.1:1025
EMAIL_FROM="gundam-tcg-hub <no-reply@localhost>"
# Passkeys (ADR-025). WebAuthn refuses an IP address as the relying party, so passkeys only
# work when the site is opened at http://localhost:3000 — not 127.0.0.1. In production:
# WEBAUTHN_RP_ID=<domain>, WEBAUTHN_ORIGIN=https://<domain>. Changing the RP ID later orphans
# every passkey already enrolled.
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGIN=http://localhost:3000
# Optional: Discord OAuth. Redirect URI is <API_BASE_URL>/api/auth/callback/discord
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Listing photos (Phase 5, SR-5.5). Start the containers with
#   docker compose --env-file .env -f infra/compose/docker-compose.dev.yml --profile photos up -d
# The bucket is private: uploads arrive by presigned PUT and leave by short-lived signed GET,
# and nothing is ever served from it directly.
S3_ENDPOINT=http://127.0.0.1:8000
S3_BUCKET=gth-photos
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=generated-by-env-init
S3_SECRET_ACCESS_KEY=generated-by-env-init
# Malware scanning. Without it, uploads stay pending rather than being approved unscanned.
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310

# The web app's copy of the above, and the only one it gets: the origin the *browser* reaches
# the bucket on. It is named in the site's CSP (connect-src for the upload, img-src for the
# photo) — without it the browser refuses both, silently, in the console. Separate from
# S3_ENDPOINT because they are not always the same host: in production the API may reach the
# bucket over an internal name the browser cannot resolve. Lives in apps/web/.env.local
# locally; supplied to the web container in deployment.
PHOTO_STORAGE_ORIGIN=http://127.0.0.1:8000

OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
