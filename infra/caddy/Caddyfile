# Reverse proxy (plan §15.3). One public entry point; everything else stays on an
# internal network with no published ports.
{
	email {$ACME_EMAIL:ops@localhost}
	servers {
		protocols h1 h2 h3
	}
	# Local runs use the internal CA instead of ACME; prod sets neither.
	{$CADDY_GLOBAL_EXTRA}
}

(security_headers) {
	header {
		Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(self)"
		Cross-Origin-Opener-Policy "same-origin"
		-Server
		-X-Powered-By
	}
}

(proxy_client_ip) {
	# Overwrite, never append: the API trusts X-Forwarded-For for per-IP rate limits
	# (API_TRUST_PROXY=true). A client-supplied value would let one caller pose as many
	# and walk straight past those limits.
	header_up X-Forwarded-For {remote_host}
	header_up X-Real-IP {remote_host}
}

{$SITE_ADDRESS:localhost} {
	import security_headers

	# An explicit allowlist, because the default (`text/*`) would catch text/event-stream.
	# A compressor holds bytes back until it has a full block, which for a stream means the
	# OBS overlay connects, receives headers, and then sits silent until the connection
	# closes. Next is configured not to compress for the same reason; this is the edge half.
	# Response matchers have no negation, so the types we serve are listed instead.
	encode zstd gzip {
		match {
			header Content-Type text/html*
			header Content-Type text/css*
			header Content-Type text/plain*
			header Content-Type text/csv*
			header Content-Type application/json*
			header Content-Type application/javascript*
			header Content-Type image/svg+xml*
		}
	}

	# Request bodies are small; uploads (Phase 5) go straight to object storage.
	request_body {
		max_size 1MB
	}

	# No access log, deliberately — and read this before adding one.
	#
	# Caddy does not log requests unless told to, and the obvious `log { output stdout }` would
	# write every URL in full. `/api/auth/magic-link/verify?token=…` carries a single-use
	# credential good for fifteen minutes and a whole account, so turning access logging on
	# naively publishes sign-in tokens to wherever the logs go (§20 ships them to Loki). The
	# API had this exact bug in its own request log until it was fixed.
	#
	# When access logs are wanted, redact the query first. This block is validated against
	# Caddy 2 and is the shape to use:
	#
	#   log {
	#       output stdout
	#       format filter {
	#           wrap json
	#           fields {
	#               request>uri query {
	#                   replace token REDACTED
	#               }
	#           }
	#       }
	#   }
	#
	# `replace token REDACTED` names one parameter. Prefer `delete` of everything not needed,
	# or keep the list under review, because the next secret parameter will not be on it.

	# The API is served under the web origin so session cookies stay same-origin.
	handle /api/auth/* {
		reverse_proxy api:4000 {
			import proxy_client_ip
		}
	}
	handle /v1/* {
		reverse_proxy api:4000 {
			import proxy_client_ip
		}
	}
	# The API documents itself, and /docs is part of the public surface (FR-3.6). It is routed
	# here for the same reason /v1 is, and because the alternative was not working: Next's own
	# rewrite reads API_INTERNAL_URL when the config is evaluated, and `output: 'standalone'`
	# bakes that in at *build* time, where the variable is unset. In production the web
	# container was therefore proxying /docs to 127.0.0.1:4000 — itself — and returning 500.
	# Nothing noticed, because the smoke test only asked for / and /v1/games. It asks for
	# /docs now too.
	handle /docs* {
		reverse_proxy api:4000 {
			import proxy_client_ip
		}
	}
	handle {
		reverse_proxy web:3000 {
			import proxy_client_ip
		}
	}
}
